    "query": "UPDATE ads_actions SET status = CASE WHEN $2 = 'approve' THEN 'approved_running' ELSE 'rejected' END, reject_reason = CASE WHEN $2 = 'approve' THEN reject_reason ELSE 'رفض المالك' END WHERE action_id = $1 AND status = 'awaiting_approval' AND created_at > now() - interval '72 hours' RETURNING action_id, action_type, payload, CASE WHEN status = 'approved_running' THEN 'approve' ELSE 'reject' END AS decision",
