{
  "id": "wameedHealth0001",
  "name": "وميض | فحص الصحة (كل 5 دقائق)",
  "nodes": [
    {
      "id": "0ed398c5-d453-5407-8b85-54fae0d1f00e",
      "name": "كل 5 دقائق",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "69ab7f5f-e3ce-5851-baf7-18a796341fbb",
      "name": "العناوين",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT wameed.cfg_text('ollama_url') AS ollama_url, wameed.cfg_text('waha_url') AS waha_url,\n       wameed.cfg_text('waha_session') AS waha_session, wameed.cfg_text('healthchecks_url') AS hc_url",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    },
    {
      "id": "4d3e5157-9458-5e3f-bb89-28c8a3146ab4",
      "name": "Ollama tags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.ollama_url }}/api/tags",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4da2f7e9-cf24-58f9-ade5-534a80262a59",
      "name": "WAHA session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('العناوين').first().json.waha_url }}/api/sessions/{{ $('العناوين').first().json.waha_session }}",
        "options": {
          "timeout": 10000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wameedWahaKey001",
          "name": "Wameed WAHA Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "f402868c-cf28-5be4-a18a-61a9eb1bf86b",
      "name": "الحكم",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "const ol = $('Ollama tags').first().json;\nconst wa = $input.first().json;\nconst models = Array.isArray(ol.models) ? ol.models.map(m => m.name) : null;\nreturn [{ json: {\n  ollama_ok: !!models, ollama_detail: models ? models.join('، ') : String((ol.error && ol.error.message) || 'لا رد'),\n  waha_ok: wa.status === 'WORKING', waha_detail: wa.status ? 'الجلسة: ' + wa.status : String((wa.error && wa.error.message) || 'لا رد'),\n}}];"
      }
    },
    {
      "id": "f41cc232-a20d-5cda-8e73-557b5afe3f6a",
      "name": "حفظ الحالة",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT wameed.set_health('ollama', $1::boolean, $2) AS ollama_changed,\n       wameed.set_health('waha', $3::boolean, $4) AS waha_changed,\n       wameed.set_health('n8n', true, 'يعمل') AS n8n_changed,\n       $1::boolean AS ollama_ok, $3::boolean AS waha_ok, $2 AS ollama_detail, $4 AS waha_detail,\n       wameed.cfg_text('healthchecks_url') AS hc_url",
        "options": {
          "queryReplacement": "={{ [ $json.ollama_ok, $json.ollama_detail, $json.waha_ok, $json.waha_detail ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    },
    {
      "id": "0b1e3e92-04f5-5f0f-8530-dfe6b143b810",
      "name": "تنبيه التغيّر",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "jsCode": "const h = $input.first().json;\nconst lines = [];\nif (h.ollama_changed) lines.push(h.ollama_ok ? '✅ Ollama (العقل المحلي) عاد للعمل' : '🚨 Ollama متوقف: الوكلاء لن يعملوا، وموجز الصباح سيصل بالقالب الثابت\\n' + h.ollama_detail);\nif (h.waha_changed) lines.push(h.waha_ok ? '✅ واتساب (WAHA) عاد للعمل' : '🚨 واتساب (WAHA) متوقف: ' + h.waha_detail);\nreturn lines.length ? [{ json: { text: lines.join('\\n\\n') } }] : [];"
      }
    },
    {
      "id": "8d6078a0-edb3-52fa-b7a1-624d37154c71",
      "name": "إشعار",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/wameed-notify",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wameedHookToken1",
          "name": "Wameed Hook Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "19badb54-33b4-56ea-bfa1-02106d559f7b",
      "name": "نبض؟",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "jsCode": "const h = $('حفظ الحالة').first().json;\nreturn h.hc_url ? [{ json: { url: h.hc_url } }] : [];"
      }
    },
    {
      "id": "657aced0-c2e1-5dbc-bab9-1b96cf60eb0a",
      "name": "Healthchecks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
