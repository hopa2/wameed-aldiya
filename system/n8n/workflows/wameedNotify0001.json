{
  "id": "wameedNotify0001",
  "name": "وميض | إشعار المالك (تيليجرام)",
  "nodes": [
    {
      "id": "adf30d75-4070-5d76-a6ff-9599cf82e048",
      "name": "طلب إشعار",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wameed-notify",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wameedHookToken1",
          "name": "Wameed Hook Token"
        }
      },
      "webhookId": "93ca83b2-42bd-56e1-aaa1-7d6f1392cfe3"
    },
    {
      "id": "9387e5c1-3e91-55a6-8a69-44434e3ba38c",
      "name": "معرّف المالك",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wameed.cfg_text('owner_chat_id') AS chat_id, $1::text AS text",
        "options": {
          "queryReplacement": "={{ [ String($json.body.text || '').slice(0, 4000) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    },
    {
      "id": "879bbfda-2442-572f-be21-33b0632eff0a",
      "name": "معرّف موجود؟",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.chat_id && $json.text ? 0 : 1 }}",
        "options": {}
      }
    },
    {
      "id": "5f42828a-c3af-51ee-949e-fb6839a17d93",
      "name": "تيليجرام",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "wameedTelegram01",
          "name": "Wameed Telegram"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "a8b643f6-1f1d-56be-9f0e-9eb63afb16d9",
      "name": "بلا معرّف",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wameed.log_event('warn', 'notify', 'لم يُرسل إشعار: owner_chat_id فارغ', jsonb_build_object('text', $1::text)) AS ok",
        "options": {
          "queryReplacement": "={{ [ $json.text ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    }
  ],
  "connections": {
