      "name": "تصفية",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json.body || {};\nconst p = e.payload || {};\nconst from = String(p.from || '');\nif (!['message', 'message.any'].includes(e.event) || p.fromMe) return [];\nif (!from.endsWith('@c.us') && !from.endsWith('@s.whatsapp.net')) return [];   // لا مجموعات ولا حالات\nconst text = String(p.body || '').trim();\nif (!text) return [];\nreturn [{ json: { chat_id: from, text: text.slice(0, 1000), wa_id: String(p.id || '') } }];"
      }
    },
    {
      "id": "3d335153-aedd-51c9-af03-3c281a7df3be",
      "name": "تسجيل + سياق",
