      "typeVersion": 2.5,
      "position": [
        720,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT wameed.wa_inbound($1, $2, $3) AS c",
        "options": {
          "queryReplacement": "={{ [ $json.chat_id, $json.text, $json.wa_id ] }}"
        }
      },
