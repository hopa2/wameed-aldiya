    {
      "id": "9c3687be-c2f3-5ad9-808d-eefb84754d9e",
      "name": "حجز الإجراء",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT c.*, wameed.cfg_text('waha_url') AS waha_url, wameed.cfg_text('waha_session') AS waha_session\nFROM wameed.claim_action($1::bigint) c",
        "options": {
          "queryReplacement": "={{ [ $json.body.action_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    },
    {
      "id": "e45e5dea-66be-5aa9-a66d-a95cdead7217",
      "name": "المنفّذ",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ ({ whatsapp: 0, telegram: 1, manual: 2 })[$json.executor] ?? 3 }}",
        "options": {}
      }
    },
    {
      "id": "3a2c8295-c1f1-5a1b-a466-c3c3fa162d3e",
      "name": "تجهيز رسالة واتساب",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst p = a.payload || {};\nconst chatId = p.chat_id || (String(p.to || '').replace(/\\D/g, '') + '@c.us');\nreturn [{ json: { ...a, chatId, text: p.text, delay: a.type === 'whatsapp_reply' ? 3 + Math.floor(Math.random() * 6) : 1 } }];"
      }
    },
    {
      "id": "5791db1e-8999-518d-ab56-2b2d5ade1214",
      "name": "تأخير طبيعي",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "amount": "={{ $json.delay }}",
        "unit": "seconds"
      },
      "webhookId": "81b3e047-d480-54a5-9b0c-684da87b5df1"
    },
    {
      "id": "edcfe878-eb19-5fab-b7b6-8088c82afe35",
      "name": "WAHA إرسال",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.waha_url }}/api/sendText",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: $json.waha_session, chatId: $json.chatId, text: $json.text }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wameedWahaKey001",
          "name": "Wameed WAHA Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "5514e623-2af1-57cc-ba7d-610c7d23e85e",
      "name": "إنهاء واتساب",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (wameed.finish_action($1::bigint, $2, $3::jsonb)).id AS id",
        "options": {
          "queryReplacement": "={{ [ $('حجز الإجراء').first().json.id, $json.error ? 'failed' : 'executed', $json.error ? { error: String($json.error.message || $json.error) } : { sent: true, id: $json.id ?? null } ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "wameedPostgres01",
          "name": "Wameed Postgres"
        }
      }
    },
    {
      "id": "14676c90-b568-5d08-8015-c9d2a228ec74",
      "name": "نص التنبيه",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst p = a.payload || {};\nlet text = p.text || '';\nif (a.type === 'whatsapp_escalation') {\n  const num = String(p.chat_id || '').replace(/@.*/, '');\n  text = '📞 عميل يحتاجك على واتساب\\n' + (p.owner_note || '') + '\\nرسالته: ' + (p.customer_text || '') + '\\nhttps://wa.me/' + num;\n}\nreturn [{ json: { ...a, text } }];"
      }
    },
    {
      "id": "f7bd731b-a3c4-51c6-a844-1e545aca48e6",
      "name": "إرسال التنبيه",
