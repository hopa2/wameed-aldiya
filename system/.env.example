# أضف هذه الأسطر إلى C:\wameed\.env (بجانب PG_PASSWORD وN8N_ENCRYPTION_KEY الموجودين).
# سكربت scripts/install.ps1 يولّد الأسرار العشوائية تلقائيًا إن لم تكن موجودة.
# لا ترفع .env إلى GitHub ولا تلصقه في أي محادثة.

COMPOSE_FILE=docker-compose.yml;wameed-aldiya/system/docker-compose.wameed.yml

# سر مشترك بين لوحة التحكم وn8n (يحمي /webhook/wameed-* حتى عبر Tailscale Funnel)
WAMEED_HOOK_TOKEN=
# كلمة سر لوحة التحكم (12 حرفًا على الأقل)
DASHBOARD_PASSWORD=

# من @BotFather (نفس بوت وكيل الإعلانات أو بوت جديد)
TELEGRAM_BOT_TOKEN=
# مفتاح WAHA على Synology (WHATSAPP_API_KEY) إن كان مفعّلًا، وإلا اتركه فارغًا
WAHA_API_KEY=
